# Local SQLite by default. For cloud sync (Mac / Windows / iPhone):
# 1) Create Neon Postgres and paste the connection string here or in Render env
# 2) Run: python scripts/migrate_sqlite_to_postgres.py
# DATABASE_URL=postgresql://user:pass@HOST/neondb?sslmode=require

SECRET_KEY=change-me-to-a-long-random-string

# --- Leaf (required for live Panorama) ---
# Either paste a JWT:
LEAF_API_TOKEN=
# Or leave token blank and use Leaf login (app will request a token):
LEAF_USERNAME=
LEAF_PASSWORD=

# --- Precision Planting Panorama partner credentials ---
# Request these from Precision Planting (partner API access)
PANORAMA_CLIENT_ID=
PANORAMA_PARTNER_USERNAME=
PANORAMA_PARTNER_PASSWORD=
PANORAMA_CLIENT_ENVIRONMENT=STAGE
